{
  "services": [
    {
      "type": "web",
      "name": "smart-academic-hub",
      "env": "node",
      "plan": "free",
      "buildCommand": "npm install && npm run build",
      "startCommand": "npm start",
      "envVars": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "PORT",
          "value": "10000"
        },
        {
          "key": "GEMINI_API_KEY",
          "generateValue": false
        },
        {
          "key": "APP_URL",
          "generateValue": false
        }
      ]
    }
  ]
}
